# Copie este arquivo para `.env` (sem o .example) e preencha com os valores
# reais do seu projeto Supabase. O .env NÃO é commitado (está no .gitignore).

# Project URL — formato https://<id>.supabase.co
VITE_SUPABASE_URL=

# anon public key — JWT longo começando com eyJ...
# É pública mesmo (segurança real vem das RLS policies no banco),
# mas evitamos deixar vazar no histórico do git.
VITE_SUPABASE_ANON_KEY=
